{
    "name": "tracepharma/filament-ui-extras",
    "description": "First-party Filament v5 panel UI enhancements (dual sub-nav, skeletons, loading bar, and more).",
    "type": "library",
    "version": "1.0.0",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.0",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Tracepharma\\FilamentUiExtras\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Tracepharma\\FilamentUiExtras\\FilamentUiExtrasServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
