APP_NAME=TracePharma
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://admin2.internal.vatengi.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_SOCKET=/run/mysqld/mysqld.sock
DB_DATABASE=tracepharma
DB_USERNAME=tracepharma
DB_PASSWORD=tracepharma

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- Object storage (production: s3) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Inbound EPCIS S3 — set a different bucket per deploy (stage vs prod).
# Keys: inbound/{uuid}.xml (IAM resource …/inbound/*).
# tracepharma-demo / tracepharma-stage / tracepharma-prod.
EPCIS_INBOUND_DISK=epcis_inbound
EPCIS_INBOUND_BUCKET=
# EPCIS_INBOUND_URL=   # optional; auto https://{bucket}.s3.{region}.amazonaws.com
EPCIS_INBOUND_URL_TTL=15
# Authored outbound/receiving/transfer XML — keep local (do not point at inbound S3).
TRACEPHARMA_EPCIS_AUTHORED_PAYLOAD_DISK=local
# Event-row archive cutoff (years). Payload files are never deleted by archive.
TRACEPHARMA_EPCIS_RETENTION_YEARS=6
# Pedigree TI rebuild needs on-disk payloads at least this long (>= retention_years).
TRACEPHARMA_EPCIS_PAYLOAD_RETENTION_YEARS=6
# Queue-backed EPCIS Jobs (authored outbound transmit). Off = sync transmit.
TRACEPHARMA_EPCIS_JOBS_ENABLED=false
TRACEPHARMA_EPCIS_JOBS_QUEUE=epcis
# EPCIS hub (centralized inbound). Prefer demo/stage/prod-specific tokens & hosts.
# Legacy EPCIS_HUB_TOKEN is a fallback when env-specific tokens are unset.
EPCIS_HUB_TOKEN=
EPCIS_HUB_TOKEN_DEMO=
EPCIS_HUB_TOKEN_STAGE=
EPCIS_HUB_TOKEN_PROD=
EPCIS_HUB_HOST_DEMO=admin2.internal.vatengi.com
EPCIS_HUB_HOST_STAGE=stage.tracepharma.io
EPCIS_HUB_HOST_PROD=prod.tracepharma.io

QUEUE_CONNECTION=redis
REDIS_QUEUE_RETRY_AFTER=3900
# When QUEUE_CONNECTION=database, must exceed the longest job $timeout (currently 3600).
DB_QUEUE_RETRY_AFTER=3900
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Mail ---
# Default: smtp (local/Mailpit). Production options: smtp (ZeptoMail SMTP) or zeptomail (ZeptoMail API).
MAIL_MAILER=smtp
MAIL_SCHEME=
MAIL_URL=
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_EHLO_DOMAIN=
MAIL_FROM_ADDRESS="noreply@tracepharma.io"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_SENDMAIL_PATH="/usr/sbin/sendmail -bs -i"
MAIL_LOG_CHANNEL=
POSTMARK_API_KEY=
POSTMARK_MESSAGE_STREAM_ID=
RESEND_API_KEY=

# ZeptoMail — SMTP (MAIL_MAILER=smtp): host smtp.zeptomail.com, port 587, scheme tls,
# username emailapikey, password = Send Mail Token from Mail Agent → SMTP/API.
# ZeptoMail — API (MAIL_MAILER=zeptomail): Send Mail Token below; uses brunocfalcao/laravel-zepto-mail-api-driver.
ZEPTOMAIL_MAIL_KEY=
# ZEPTO_MAIL_ENDPOINT=https://api.zeptomail.eu

# --- Marketing / platform support ---
MARKETING_DEMO_NOTIFY_EMAIL=
MARKETING_ONBOARDING_NOTIFY_EMAIL=
MARKETING_ONBOARDING_FROM_EMAIL=onboarding@tracepharma.io
MARKETING_ONBOARDING_FROM_NAME="TracePharma Onboarding"
PLATFORM_SUPPORT_EMAIL=support@tracepharma.io
LEGAL_CONTACT_EMAIL=legal@tracepharma.io
PRIVACY_CONTACT_EMAIL=privacy@tracepharma.io
OPS_ALERT_EMAIL=ops@tracepharma.io
EXCEPTION_MAIL_FROM=dscsaexceptions@tracepharma.io
EXCEPTION_MAIL_FROM_NAME="DSCSA Exceptions"

SCOUT_DRIVER=meilisearch
# Optional prefix when multiple apps share one Meilisearch cluster (default empty).
SCOUT_PREFIX=
# Queue Scout model sync in production for throughput and resilience.
SCOUT_QUEUE=true
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=

CENTRAL_DOMAIN=internal.vatengi.com
ADMIN_DOMAIN=admin2.internal.vatengi.com
MARKETING_DOMAIN=internal.vatengi.com
PLATFORM_BASE_DOMAIN=tracepharma.io
TENANT_ENVIRONMENT=prod
# Central DB of the other pair environment (prod writes stage hosts here).
PAIR_SIBLING_DB_DATABASE=
DEMO_DOMAINS=demo2.internal.vatengi.com,demo2.localhost

VITE_APP_NAME="${APP_NAME}"

# RapidAPI Local Business Data (Places backfill)
PLACES_API_BASE_URL=https://local-business-data.p.rapidapi.com/search
PLACES_API_HOST=local-business-data.p.rapidapi.com
PLACES_API_KEY=
PLACES_API_REGION=us
PLACES_API_LANGUAGE=en
PLACES_API_LIMIT=20
PLACES_API_ZOOM=13

# FDA official feeds (Pure FDA registry)
FDA_DECRS_URL=https://www.accessdata.fda.gov/cder/drls_reg.zip
FDA_WDD_URL=https://www.accessdata.fda.gov/cder/wdd_3pl_facilities_report.txt
FDA_ORG_MATCH_HIGH=92
FDA_ORG_MATCH_LOW=75

# --- VRS (Verification Router Service) ---
# Driver: fake (local/test), http (live VRS), null (deferred/no-op).
# Production defaults to null when VRS_DRIVER is unset — intentional until a real endpoint is wired.
# For go-live: VRS_DRIVER=http + real VRS_BASE_URL/API_KEY/REQUESTOR_GLN (not *.example.com).
# See docs/integrations/vrs-verify-readiness.md (internal readiness — not Gateway Certified).
# VRS_DRIVER=fake
# VRS_BASE_URL=https://vrs.example.com
# VRS_VERIFY_PATH=/api/v1/verify
# VRS_API_KEY=
# VRS_TIMEOUT=30
# VRS_REQUESTOR_GLN=
# Shared secret for POST /api/webhooks/vrs/{tenantId} (X-Vrs-Api-Key or Bearer).
# VRS_RESPONDER_API_KEY=

# Shared secret for POST /api/webhooks/wms/{tenantId} (X-Wms-Api-Key or Bearer).
# WMS_BRIDGE_API_KEY=

# Filament Watchdog (admin security monitoring)
WATCHDOG_EMAIL_ENABLED=false
WATCHDOG_EMAIL_RECIPIENTS=
WATCHDOG_MIN_SEVERITY=high
WATCHDOG_SIGNATURES_URL=https://raw.githubusercontent.com/MKWebDesign/filament-watchdog-v5/main/signatures.json
