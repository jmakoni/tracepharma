{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "tracepharma/tracepharma",
    "type": "project",
    "description": "TracePharma \u2014 multi-tenant pharmacy EPCIS / DSCSA platform.",
    "keywords": [
        "laravel",
        "filament",
        "dscsa",
        "epcis"
    ],
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "bokshorn-it/filament-activity-timeline": "*",
        "brunocfalcao/laravel-zepto-mail-api-driver": "^1.1",
        "dompdf/dompdf": "^3.1",
        "filament/filament": "^5.0",
        "guava/filament-knowledge-base": "^3.0",
        "jeffgreco13/filament-breezy": "^3.2",
        "kisame76/filament-advanced-rich-editor": "^1.4",
        "laravel/framework": "^13.8",
        "laravel/horizon": "^5.47",
        "laravel/sanctum": "^4.3",
        "laravel/scout": "^11.2",
        "laravel/socialite": "*",
        "laravel/tinker": "^3.0",
        "league/flysystem-aws-s3-v3": "^3.34",
        "league/flysystem-sftp-v3": "^3.33",
        "league/html-to-markdown": "^5.1",
        "meilisearch/meilisearch-php": "^1.16",
        "mkwebdesign/filament-watchdog-v5": "*",
        "socialiteproviders/manager": "*",
        "socialiteproviders/microsoft-azure": "*",
        "socialiteproviders/okta": "*",
        "spatie/laravel-activitylog": "^5.0",
        "spatie/laravel-data": "^4.0",
        "spatie/laravel-permission": "^8.0",
        "ssbityukov/filament-command-center": "*",
        "stancl/tenancy": "^3.10",
        "zeeshantariq/filament-sticky-columns": "*",
        "zvizvi/filament-notifications-tabs": "^0.0.2"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "exclude-from-classmap": [
            "vendor/filament/actions/src/Concerns/HasLabel.php"
        ],
        "files": [
            "app/Filament/Overrides/Actions/HasLabel.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install --ignore-scripts",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1 --timeout=0\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "test:prepare": [
            "bash scripts/prepare-test-database.sh"
        ],
        "test": [
            "@test:prepare",
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "bash scripts/ensure-filament-sticky-columns-views.sh",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
